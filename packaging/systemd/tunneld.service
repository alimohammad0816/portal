[Unit]
Description=Tunnel VPN daemon
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=dbus
BusName=org.tunnelvpn.Daemon1
ExecStart=/usr/libexec/tunneld
Restart=on-failure
RestartSec=2

StateDirectory=tunneld
StateDirectoryMode=0700
RuntimeDirectory=tunneld
RuntimeDirectoryMode=0700
# Verified update packages wait here for apt (which runs as _apt for reads).
CacheDirectory=tunneld
CacheDirectoryMode=0755

# OpenVPN needs to create tun devices and change routes. Split tunneling
# moves app processes between cgroups (so the cgroup tree stays writable)
# and reads which program each process runs (CAP_SYS_PTRACE, read-only).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/net/tun rw
ReadWritePaths=-/run/resolvconf -/run/systemd/resolve

[Install]
WantedBy=multi-user.target
Alias=dbus-org.tunnelvpn.Daemon1.service
