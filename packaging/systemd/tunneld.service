[Unit]
Description=Tunnel VPN daemon
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=dbus
BusName=org.tunnelvpn.Daemon1
ExecStart=/usr/libexec/tunneld
Restart=on-failure
RestartSec=2

StateDirectory=tunneld
StateDirectoryMode=0700
RuntimeDirectory=tunneld
RuntimeDirectoryMode=0700

# OpenVPN needs to create tun devices and change routes; nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/net/tun rw
ReadWritePaths=-/run/resolvconf -/run/systemd/resolve

[Install]
WantedBy=multi-user.target
Alias=dbus-org.tunnelvpn.Daemon1.service
