{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel",
  "identifier": "org.tunnelvpn.Tunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "cargo build --release --locked -p tunneld -p tunnel-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tunnel",
        "width": 440,
        "height": 860,
        "minWidth": 400,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "OpenVPN client with split tunneling",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "longDescription": "Tunnel imports your OpenVPN profiles and connects with one click. It includes a background service (tunneld), a desktop app with a tray icon, and the `tunnel` command-line tool.",
    "license": "GPL-3.0-or-later",
    "linux": {
      "deb": {
        "depends": ["openvpn", "nftables", "systemd-resolved | systemd (<< 251)", "polkitd | policykit-1", "iputils-ping"],
        "section": "net",
        "files": {
          "/usr/libexec/tunneld": "../../../target/release/tunneld",
          "/usr/bin/tunnel": "../../../target/release/tunnel",
          "/usr/lib/systemd/system/tunneld.service": "../../../packaging/systemd/tunneld.service",
          "/usr/share/dbus-1/system.d/org.tunnelvpn.Daemon1.conf": "../../../packaging/dbus/org.tunnelvpn.Daemon1.conf",
          "/usr/share/dbus-1/system-services/org.tunnelvpn.Daemon1.service": "../../../packaging/dbus/org.tunnelvpn.Daemon1.service",
          "/usr/share/polkit-1/actions/org.tunnelvpn.policy": "../../../packaging/polkit/org.tunnelvpn.policy",
          "/usr/share/gnome-shell/extensions/tunnel@tunnelvpn.org/metadata.json": "../../../packaging/gnome-shell/tunnel@tunnelvpn.org/metadata.json",
          "/usr/share/gnome-shell/extensions/tunnel@tunnelvpn.org/extension.js": "../../../packaging/gnome-shell/tunnel@tunnelvpn.org/extension.js"
        },
        "postInstallScript": "../../../packaging/deb/postinst",
        "preRemoveScript": "../../../packaging/deb/prerm",
        "postRemoveScript": "../../../packaging/deb/postrm"
      }
    }
  }
}
